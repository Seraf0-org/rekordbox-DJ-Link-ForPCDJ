PORT=8787
PYTHON_BIN=python
# Compatibility placeholder only: server/index.js currently fixes this to
# false, so changing this env value alone cannot enable DB補完.
PYTHON_BRIDGE_ENABLED=false
REKORDBOX_POLL_MS=500
HISTORY_OFFSET_SECONDS=60

# DJ Agent extension (all optional; disabled unless explicitly enabled)
DJ_AGENT_ENABLED=false
DJ_AGENT_CONFIG_PATH=
DJ_AGENT_ALLOW_REMOTE_ACTIONS=false
SYNDOCAL_ENABLED=true
SYNDOCAL_HOST=127.0.0.1
SYNDOCAL_PORT=9100
SYNDOCAL_PATH=/ws
SYNDOCAL_NIC=
SYNDOCAL_TOKEN=
# Select an adapter explicitly. generic-json is a generic boundary, not a
# claim of Syndocal/KDMX protocol interoperability.
SYNDOCAL_WS_ADAPTER=generic-json
MIDI_ENABLED=true
MIDI_MODULE=@julusian/midi
MIDI_DEVICE=
MIDI_PORT=
# Optional JSON map from Rekordbox deck number to MIDI channel; empty keeps
# each mapping's configured channel (for example {"1":1,"2":2}).
MIDI_DECK_CHANNELS=
# Optional JSON release-macro configuration. Empty keeps the legacy direct
# stop/release path. Enable explicitly only after learning these mappings.
# MIDI_RELEASE_FADE={"enabled":true,"mapping":"releaseFade","target":"deck","startValue":127,"endValue":0,"durationMs":1000,"updateIntervalMs":50,"resetAfterStop":true,"resetValue":127}
# sequence accepts "parallel" (default, backwards-compatible) or
# "filter-then-fade" (HP ramp must finish before ChannelFader starts).
# MIDI_RELEASE_MACRO={"enabled":true,"sequence":"filter-then-fade","filter":{"startValue":64,"endValue":127,"durationMs":1000,"updateIntervalMs":50,"resetValue":64},"resetAfterStop":true}
PEDAL_ENABLED=true
PEDAL_MODULE=uiohook-napi

# Optional:
# REKORDBOX_EXE_PATH=C:\Program Files\rekordbox\rekordbox 7.2.18\rekordbox.exe
# REKORDBOX_DB_PATH=C:\Users\<you>\AppData\Roaming\Pioneer\rekordbox\master.db
# REKORDBOX_DB_DIR=C:\Users\<you>\AppData\Roaming\Pioneer\rekordbox
# REKORDBOX_DB_KEY=<sqlcipher-key>

# Ableton Link
ABLETON_LINK_ENABLED=false
ABLETON_LINK_MODULE=@ktamas77/abletonlink
ABLETON_LINK_INITIAL_TEMPO=120

# Rekordbox Hook UDP (from injected rb_hook.dll)
HOOK_UDP_ENABLED=true
HOOK_UDP_PORT=22346
