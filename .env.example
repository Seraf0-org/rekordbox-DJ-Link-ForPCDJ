PORT=8787
# HTTP diagnostics/UI bind address. Leave blank for the IPv4 LAN default
# (0.0.0.0). For local-only DJ/Syndocal use, set 127.0.0.1 explicitly.
# Non-empty values must be an IPv4 or raw/bracketed IPv6 literal; invalid
# values and hostnames fail startup instead of falling back to a wider bind.
RB_OUTPUT_HOST=
PYTHON_BIN=python
# Compatibility placeholder only: server/index.js currently fixes this to
# false, so changing this env value alone cannot enable DB補完.
PYTHON_BRIDGE_ENABLED=false
REKORDBOX_POLL_MS=500
HISTORY_OFFSET_SECONDS=60

# DJ Agent controlled show path. It remains disabled unless this is an absolute
# path to the exact external v1.1.11 filter-then-fade-then-stop configuration created by
# start-all.bat --init-config or --upgrade-config. Do not use DJ_AGENT_ENABLED, inline JSON, or
# SYNDOCAL_/MIDI_/PEDAL_ overrides: runtime rejects all of them.
DJ_AGENT_CONFIG_PATH=

# Optional:
# REKORDBOX_DB_PATH=C:\Users\<you>\AppData\Roaming\Pioneer\rekordbox\master.db
# REKORDBOX_DB_DIR=C:\Users\<you>\AppData\Roaming\Pioneer\rekordbox
# REKORDBOX_DB_KEY=<sqlcipher-key>

# Ableton Link
ABLETON_LINK_ENABLED=false
ABLETON_LINK_MODULE=@ktamas77/abletonlink
ABLETON_LINK_INITIAL_TEMPO=120

# Rekordbox Hook UDP (from injected rb_hook.dll)
HOOK_UDP_ENABLED=true
HOOK_UDP_PORT=22346
