{
  "name": "rb-output",
  "version": "1.1.10",
  "description": "Rekordbox now-playing and realtime BPM viewer for LAN devices",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "poc:rekordbox": ".venv\\Scripts\\python python/poc_rekordbox_probe.py",
    "poc:link": "node scripts/poc-ableton-link.js",
    "build:hook": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-hook.ps1",
    "inject:hook": ".venv\\Scripts\\python scripts/inject_hook.py",
    "hook:prepare": "npm run build:hook && npm run inject:hook",
    "build:dist": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-dist.ps1",
    "preflight": "node scripts/preflight.js",
    "verify:install": "node scripts/verify-install.js --install-dir",
    "test": "node --test"
  },
  "keywords": [
    "rekordbox",
    "flx10",
    "ableton-link",
    "socket.io",
    "now-playing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "pkg": {
    "scripts": [
      "server/**/*.js",
      "node_modules/ws/**/*.js"
    ],
    "assets": [
      "node_modules/ws/**/*",
      "node_modules/@ktamas77/abletonlink/package.json",
      "node_modules/@ktamas77/abletonlink/build/Release/abletonlink.node",
      "node_modules/@julusian/midi/prebuilds/**/*",
      "node_modules/@julusian/midi/**/*.node",
      "node_modules/uiohook-napi/prebuilds/**/*",
      "node_modules/uiohook-napi/**/*.node"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.22.0",
    "node-gyp": "12.4.0"
  },
  "optionalDependencies": {
    "@julusian/midi": "^3.8.1",
    "@ktamas77/abletonlink": "^1.2.3",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.3"
  }
}
